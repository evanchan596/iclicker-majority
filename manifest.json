{
  "manifest_version": 3,
  "name": "iClicker Majority",
  "version": "2.0.0",
  "description": "Background iClicker polling with live leader, on-device AI, and random fallbacks, plus local answer-source history.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage", "alarms"],
  "host_permissions": ["https://api.iclicker.com/*", "https://student.iclicker.com/*"],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "iClicker Majority",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://student.iclicker.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
